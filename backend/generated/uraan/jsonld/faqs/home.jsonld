{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "url": "https://urraan.pk/",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is URRAAN?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "URRAAN is a Corporate Social Responsibility (CSR) project by CODEMATICS Services Pvt. Ltd. It aims to empower Pakistani youth by providing them with necessary digital skills, enabling them to play a positive role in the digital economy."
      }
    },
    {
      "@type": "Question",
      "name": "What kind of training does URRAAN offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "URRAAN provides two months of free, hands-on training and internships in a wide range of digital skills. The training takes place in Abbottabad from Monday to Friday, 9 am to 6 pm."
      }
    },
    {
      "@type": "Question",
      "name": "What specific digital skills are taught at URRAAN?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "URRAAN offers training in areas such as UXUI and Graphic Designing, 3D-Animation, Android Development, Flutter App Development, Web Development, iOS Development, Digital Marketing, and Game Development. They also provide a Young Leader’s Program."
      }
    },
    {
      "@type": "Question",
      "name": "What are URRAAN's main goals?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "URRAAN aims to provide digital skills and training to youth, bridge the gap between academia and industry, and incubate innovative ideas by mentoring start-ups and providing grants. Their success rate is over 75%, with candidates often starting freelancing, getting jobs, or launching their own ventures."
      }
    }
  ]
}