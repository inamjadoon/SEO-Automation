  "mainEntity": [
    {
      "@type": "Question",
      "name": "Who is Bob Berri?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bob Berri is the Owner & Founder of The Second Mortgages. He established the company to simplify private mortgage lending and put a personal touch back into the process."
      }
    },
    {
      "@type": "Question",
      "name": "What is the mission of The Second Mortgages?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Second Mortgages aims to simplify private mortgage lending and reintroduce a personal touch to the process. They believe everyone deserves an uncomplicated route to homeownership, supported by trust and transparency."
      }
    },
    {
      "@type": "Question",
      "name": "What experience does Bob Berri have in the mortgage industry?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bob Berri has 15 years of mortgage experience in the private mortgage industry. He has supplied over 100 private mortgages and achieved $250M in sales."
      }
    },
    {
      "@type": "Question",
      "name": "Why did Bob Berri establish The Second Mortgages?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bob Berri established The Second Mortgages after noticing individuals and families felt lost in financing complexities, overwhelmed by confusing terms, and treated impersonally. He wanted to offer a simpler, more personal approach to private mortgage lending."
      }
    }
  ]
}