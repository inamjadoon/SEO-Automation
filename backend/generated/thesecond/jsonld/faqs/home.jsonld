      "@type": "Question",
      "name": "What makes private mortgages from Bob Berri different from traditional banks?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We offer fast, flexible private mortgages with custom solutions and real decisions made by people, not algorithms. Our financing is built around your reality, not rigid bank rules, catering to complex lives and non-traditional income."
      }
    },
    {
      "@type": "Question",
      "name": "Who can benefit from these private lending solutions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our private lending solutions are designed for first-time buyers, self-employed individuals, or those with credit challenges. We build financing around your specific reality to help people with big goals access the funds they need."
      }
    },
    {
      "@type": "Question",
      "name": "What is the maximum loan-to-value (LTV) financing available?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We provide mortgage solutions with financing of up to 85 percent of your property’s value. This allows clients to access more capital and maximize leverage, even with flexible qualification guidelines."
      }
    },
    {
      "@type": "Question",
      "name": "How quickly can I get approved and funded?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We offer fast approvals for our private mortgage solutions. Clients can typically get funded in as little as 48 hours, providing quick access to the money they need."
      }
    }
